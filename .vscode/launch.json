{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Valo Optimise",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run as Admin (bat)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "${workspaceFolder}/Launch as Admin.bat"],
      "console": "externalTerminal"
    }
  ]
}
